package com.meninblue.live

import android.app.*
import android.content.Intent
import android.os.Build
import android.os.IBinder
import androidx.core.app.NotificationCompat
import kotlinx.coroutines.*
import org.json.JSONObject
import java.net.HttpURLConnection
import java.net.URL

class CricketService : Service() {
    private val scope = CoroutineScope(Dispatchers.IO + Job())
    private val CHANNEL_ID = "cricket_live_score"
    private val NOTIF_ID = 1001

    override fun onCreate() {
        super.onCreate()
        createNotificationChannel()
    }

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        if (intent?.action == "STOP") {
            stopForeground(STOP_FOREGROUND_REMOVE)
            stopSelf()
            return START_NOT_STICKY
        }

        val initialNotif = buildNotification("Connecting...", "Starting Men In Blue Tracker")
        startForeground(NOTIF_ID, initialNotif)

        scope.launch {
            while (isActive) {
                fetchAndUpdate()
                delay(12_000) // Polls every 12 seconds
            }
        }

        return START_STICKY
    }

    private fun fetchAndUpdate() {
        try {
            val url = URL("https://men-in-blue-live-dopx2-weld.vercel.app/api/cron-update")
            val conn = url.openConnection() as HttpURLConnection
            conn.connectTimeout = 4000
            conn.readTimeout = 4000
            conn.setRequestProperty("User-Agent", "MenInBlue-Android")

            if (conn.responseCode == 200) {
                val body = conn.inputStream.bufferedReader().use { it.readText() }
                val json = JSONObject(body)
                val content = json.getJSONObject("payload")
                    .getJSONObject("aps")
                    .getJSONObject("content-state")

                val score = content.optString("scoreString", "0/0")
                val overs = content.optString("oversString", "")
                val crr = content.optString("currentRunRate", "")
                val status = content.optString("statusMessage", "Match Live")

                val title = "🇮🇳 IND vs 🇳🇿 NZ   🔴 LIVE"
                val text = "$score $overs  •  $crr"

                val notif = buildNotification(title, text, status)
                val manager = getSystemService(NotificationManager::class.java)
                manager.notify(NOTIF_ID, notif)
            }
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }

    private fun buildNotification(title: String, text: String, subtext: String = ""): Notification {
        val stopIntent = Intent(this, CricketService::class.java).apply { action = "STOP" }
        val pStop = PendingIntent.getService(this, 0, stopIntent, PendingIntent.FLAG_IMMUTABLE)

        return NotificationCompat.Builder(this, CHANNEL_ID)
            .setSmallIcon(android.R.drawable.ic_media_play)
            .setContentTitle(title)
            .setContentText(text)
            .setSubText(subtext)
            .setOngoing(true)
            .setOnlyAlertOnce(true)
            .setPriority(NotificationCompat.PRIORITY_MAX)
            .setCategory(NotificationCompat.CATEGORY_STATUS)
            .addAction(android.R.drawable.ic_menu_close_clear_cancel, "Stop", pStop)
            .build()
    }

    private fun createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel(
                CHANNEL_ID,
                "Live Cricket Scores",
                NotificationManager.IMPORTANCE_HIGH
            ).apply {
                description = "Ball-by-ball Lock Screen and Status Bar score updates"
                setShowBadge(true)
            }
            getSystemService(NotificationManager::class.java)?.createNotificationChannel(channel)
        }
    }

    override fun onDestroy() {
        scope.cancel()
        super.onDestroy()
    }

    override fun onBind(intent: Intent?): IBinder? = null
}
